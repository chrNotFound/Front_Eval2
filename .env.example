# ============================================================
# .env.example - Frontend Flask
# Copiar como .env y completar con valores reales
# NUNCA subir el archivo .env al repositorio
# ============================================================

# Puerto del servidor Flask
PORT=5000

# Modo debug (False en producción)
DEBUG=False

# URL del backend API (usar IP privada de EC2 backend en producción)
BACKEND_URL=http://localhost:3000

# Clave secreta para sesiones Flask (cambiar por valor seguro)
SECRET_KEY=cambiar_por_clave_segura_en_produccion
